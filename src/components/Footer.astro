---
const nav = [
  { href:'#programas', label:'Programas' },
  { href:'#porque',    label:'Por qué FORJA' },
  { href:'#horarios',  label:'Horarios' },
  { href:'#planes',    label:'Planes' },
];
const social = [
  { href:'#', label:'Instagram' },
  { href:'#', label:'TikTok' },
  { href:'#', label:'YouTube' },
];
---
<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="#" class="logo" aria-label="FORJA inicio">FOR<span>JA</span></a>
        <p>Centro de entrenamiento funcional y de fuerza en Manizales. Entrena con propósito.</p>
      </div>

      <nav aria-label="Navegación footer">
        <h4>Navegación</h4>
        <ul>
          {nav.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="foot-col">
        <h4>Síguenos</h4>
        <ul>
          {social.map(s => (
            <li>
              <a href={s.href} rel="noopener noreferrer" target="_blank">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <address class="foot-col">
        <h4>Contacto</h4>
        <p>Av. Santander #50-30<br>Manizales, Caldas</p>
        <a href="tel:+573000000000">+57 300 000 0000</a>
        <a href="mailto:hola@forjagym.co">hola@forjagym.co</a>
      </address>
    </div>

    <div class="foot-bottom">
      <span>© 2026 FORJA Centro de Entrenamiento.</span>
      <span>Lun–Vie 5am–10pm · Sáb 6am–6pm</span>
    </div>
  </div>
</footer>

<style>
footer {
  background:#070809;
  padding:clamp(50px,8vh,80px) 0 30px;
  border-top:1px solid rgba(255,255,255,.08);
}
.foot-top {
  display:grid;
  grid-template-columns:1.4fr 1fr 1fr 1.2fr;
  gap:clamp(24px,4vw,48px);
  padding-bottom:40px;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.logo {
  font-family:'Anton',sans-serif;
  font-size:1.6rem;
  letter-spacing:.04em;
}
.logo span { color:#CCFF00 }
.foot-brand p {
  color:#8C9197;
  font-size:.9rem;
  margin-top:14px;
  line-height:1.65;
}
h4 {
  font-family:'Sora',sans-serif;
  font-size:.74rem;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:#5A5F66;
  margin-bottom:16px;
}
ul { display:flex; flex-direction:column; gap:10px }
li a, address a {
  display:block;
  color:#8C9197;
  font-size:.9rem;
  font-style:normal;
  transition:color .25s;
}
li a:hover, address a:hover { color:#CCFF00 }
li a:focus-visible, address a:focus-visible {
  outline:2px solid #CCFF00; outline-offset:2px; border-radius:2px;
}
address p { color:#8C9197; font-size:.9rem; margin-bottom:10px; font-style:normal }

.foot-bottom {
  padding-top:26px;
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px;
  font-size:.8rem;
  color:#5A5F66;
}

@media(max-width:900px){
  .foot-top { grid-template-columns:1fr 1fr }
}
@media(max-width:500px){
  .foot-top { grid-template-columns:1fr }
}
</style>
