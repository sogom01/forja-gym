---
const features = [
  {
    n: '01',
    title: 'Plan a tu medida',
    desc:  'Evaluamos tu punto de partida y diseñamos una ruta clara hacia tu meta.',
  },
  {
    n: '02',
    title: 'Entrenadores certificados',
    desc:  'Acompañamiento real en cada serie, no solo máquinas y espejos.',
  },
  {
    n: '03',
    title: 'Horarios flexibles',
    desc:  'Abrimos de 5 a.m. a 10 p.m. para que entrenes cuando puedas.',
  },
  {
    n: '04',
    title: 'Comunidad que motiva',
    desc:  'Entrena rodeado de gente que empuja en la misma dirección que tú.',
  },
];
---
<section class="section why" id="porque">
  <div class="wrap why-grid">

    <div class="reveal why-img">
      <img
        src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&w=800&q=80"
        alt="Entrenador FORJA guiando a un atleta"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="why-text">
      <div class="reveal">
        <span class="eyebrow">Por qué FORJA</span>
        <h2>No es un gimnasio.<br>Es tu equipo.</h2>
      </div>
      {features.map((f, i) => (
        <div class="feat reveal" data-delay={String(i)}>
          <div class="ic" aria-hidden="true">{f.n}</div>
          <div>
            <h4>{f.title}</h4>
            <p>{f.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
.why { background:#131519 }

.why-grid {
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  gap:clamp(40px,6vw,80px);
  align-items:center;
}

/* Image with volt border offset */
.why-img {
  position:relative;
  aspect-ratio:4/5;
  overflow:hidden;
}
.why-img img {
  width:100%; height:100%;
  object-fit:cover;
  filter:grayscale(.35) contrast(1.05);
}
.why-img::before {
  content:"";
  position:absolute; inset:0;
  border:2px solid #CCFF00;
  transform:translate(18px,18px);
  z-index:1; pointer-events:none;
}

/* Text side */
.why-text h2 {
  font-size:clamp(2rem,5vw,3.6rem);
  margin:.2em 0 .8em;
}

.feat {
  display:flex; gap:18px;
  padding:20px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.feat:last-child { border-bottom:1px solid rgba(255,255,255,.08) }
.ic {
  font-family:'Anton',sans-serif;
  font-size:1.4rem; color:#CCFF00;
  width:44px; flex:none; padding-top:2px;
}
.feat h4 {
  font-family:'Sora',sans-serif;
  font-weight:700; font-size:1.05rem;
  margin-bottom:4px;
}
.feat p { font-size:.92rem; color:#8C9197 }

@media(max-width:900px){
  .why-grid { grid-template-columns:1fr }
  .why-img  { order:-1; max-width:480px; aspect-ratio:3/2 }
  .why-img::before { transform:translate(10px,10px) }
}
</style>
